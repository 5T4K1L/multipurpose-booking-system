# Web/API origins (no trailing slash). The Go API reads process environment;
# this template is not automatically loaded by the API.
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:8080
# Set this in the Next.js build environment when changing the API address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# OAuth is opt-in; password login works with both providers disabled.
GOOGLE_OAUTH_ENABLED=false
APPLE_OAUTH_ENABLED=false
OAUTH_ALLOW_REGISTRATION=false
# Exactly 32 random bytes encoded as unpadded base64url. Never commit a real key.
OAUTH_TRANSACTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Apple requires public HTTPS API and web origins, not localhost.
APPLE_OAUTH_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=
APPLE_OAUTH_REDIRECT_URL=
